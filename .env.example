# PostgreSQL connection string used by the app.
# Local (npm run db:up): postgresql://n5deal:n5deal@localhost:5433/n5deal
# Neon: the pooled connection string (host contains "-pooler"), with ?sslmode=require
DATABASE_URL="postgresql://n5deal:n5deal@localhost:5433/n5deal"

# Optional. Direct (non-pooled) connection used by Prisma CLI for migrations and seeding.
# Leave empty locally. On Neon, use the connection string WITHOUT "-pooler" in the host.
# The Neon integration on Vercel sets this automatically.
DATABASE_URL_UNPOOLED=""

# Optional. Enables AI search (Gemini; free key at https://aistudio.google.com/apikey).
# Without it, AI search falls back to keyword search.
GEMINI_API_KEY=""
